# /etc/crest-worker/crest-worker.env - Jetstream2 CREST-iMAP GPU worker.
# NO SECRETS IN THIS FILE. The HF token lives only in /etc/crest-worker/hf_token
# (root:root 0600) and reaches the service through systemd LoadCredential=.
#
# Read by systemd (EnvironmentFile=) and by bootstrap.sh / update.sh.
# Format: KEY=VALUE, one per line. No `export`, no ${VAR} expansion, and NO
# inline comments (systemd would keep them as part of the value).
# bootstrap.sh copies this example once and never overwrites your edits.
# Runbook: docs/JETSTREAM2_WORKER.md

# ---------------------------------------------------------------- code pins
# Fork (solver). Default = fork v2 c5184759 (draining-time outflow limiter +
# interflow store), approved by the PI on 2026-10-20 and run by the ZeroGPU
# worker. update.sh refuses any FORK_REF whose solver-path files differ from
# that approved commit unless ALLOW_SOLVER_CHANGE=1 (a user decision).
# The CPU Spaces still pin 4c55c0f6 (the floor: nothing older may run).
FORK_REPO=https://github.com/mchen15ouedu/CREST-iMAP.git
FORK_REF=c518475956c933a9c0fc46962b3825685a54b181
ALLOW_SOLVER_CHANGE=0
# CREST_AI hf_data (rendering + publishing + retention). Use GitHub main: it
# is meant to be identical to the deployed Spaces. Must be >= 731ab17
# (pinned.json protection); every release is refused if eventstore lacks
# pinned_ids.
CREST_AI_REPO=https://github.com/mchen15ouedu/CREST_AI.git
CREST_AI_REF=main
# Daily refresh (crest-worker-update.timer -> update.sh --auto): newest
# CREST_AI_REF hf_data, restart only between visits and only if hf_data/
# changed. 0 = off (re-run bootstrap.sh after changing it); then nothing keeps
# hf_data current and healthcheck.sh reports the drift.
AUTO_UPDATE=1
# The Space whose deployed hf_data the ZeroGPU worker and CPU Spaces publish
# with. healthcheck.sh / update.sh compare the release's publish-path modules
# (eventstore, eventsim, eventqueue, provenance) against it (read-only).
HFDATA_REF_SPACE=vincewin/CREST_demo

# ------------------------------------------------------------------- runtime
CREST_DATA_REPO=vincewin/CREST_data
# Provenance stamp in published manifests (claims still read <hostname>:<pid>,
# which crestimap.worker hard-codes). Leave commented to get
# jetstream2:<hostname> (set by run-worker.sh).
#EVENT_ENGINE_IDENT=jetstream2:crest-js2-gpu1
EVENT_DEVICE=cuda
# Per-device cell budget (bounding-box cells at native resolution). Jobs
# above it are never claimed and never coarsened. g3.large (20 GB vGPU):
# 40000000. g3.xl (40 GB A100): 90000000. preflight.sh refuses a value the
# card cannot hold: (0.85 * VRAM - 1 GiB) / BYTES_PER_CELL_EST.
EVENT_MAX_CELLS_GPU=40000000
# Peak solver bytes per bbox cell used by that check. 350 = the OSCER brief's
# planning figure (CPU-allocator probe: 280-292). Replace with the G1 replay's
# measured reserved bytes/cell plus 10 %.
BYTES_PER_CELL_EST=350
# CFL recompute every step (validated default; k=10 drifted 2.5 cm).
EVENT_DT_EVERY=1
EVENT_MAX_SESSIONS=6
EVENT_EVICT_IDLE_H=12
# Extra crestimap.worker flags. ALLOW-list: only `--poll-s N` (queue poll
# interval, 30-3600 s; worker default 60). Anything else is refused, because
# argparse accepts flag prefixes and the last value wins (--on = --once,
# --crest = --crest-ai, --max-cells past the VRAM check). Shadow runs
# (--no-publish) hold live claims: use replay_bundle.py instead.
WORKER_EXTRA_ARGS=

# --------------------------------------------------------------------- disk
# Full paths (no expansion). Recommended: a Jetstream2 volume (every
# allocation has 1 TB of Jetstream2-Storage by default), e.g. 300 GB attached
# in Exosphere, which mounts it at /media/volume/<name>. Running
# `sudo INIT_DATA_ROOT=/media/volume/crest-data bash bootstrap.sh` on the first
# run writes that prefix here; later, edit the four paths and re-run
# bootstrap.sh. Paths under /media/volume/ are refused while no volume is
# mounted there. The values below are the 60 GB root disk, which also holds
# the OS, the venv and the releases.
DATA_ROOT=/var/lib/crest-worker/data
WORKER_WORK_ROOT=/var/lib/crest-worker/data/jobs
EVENT_DEM_CACHE=/var/lib/crest-worker/data/dem_cache
HF_HOME=/var/lib/crest-worker/data/hf_home
HF_HUB_DISABLE_TELEMETRY=1
# prune.sh (daily timer): HF download-cache blobs older than this many days.
HF_CACHE_KEEP_DAYS=2
# Below this free space, preflight warns and prune.sh drops DEM tiles not
# read for DEM_KEEP_DAYS.
DISK_MIN_FREE_GB=12
DEM_KEEP_DAYS=60

# ------------------------------------------------------------ SU accounting
# healthcheck.sh estimate only (the real balance is on the Exosphere
# allocation card / ACCESS portal, 12-24 h behind).
SU_BUDGET=200000
SU_BUDGET_START=
